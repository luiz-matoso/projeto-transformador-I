# Execute python -m api.auth init para gerar o hash e a chave JWT.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Inferência local: pacote funcional V2.
MOBILIZA_DEVICE=cpu
MOBILIZA_SEGFORMER_CHECKPOINT=.modal-models/segformer/best_segformer.pt
MOBILIZA_DINO_CHECKPOINT=.modal-models/dinov2/best_dinov2_v2.pt
MOBILIZA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Necessário para cadastro de perfis e histórico.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
